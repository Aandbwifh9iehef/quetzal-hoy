{
  "name": "quetzal-hoy",
  "main": "src/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],

  // Assets estáticos servidos desde /public
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },

  // KV para datos dinámicos (tipo de cambio, noticias).
  // Raúl: crear el namespace en Cloudflare (Storage & Databases → KV) y pegar su ID aquí.
  "kv_namespaces": [{ "binding": "DATA", "id": "PEGAR_ID_DEL_KV_AQUI" }],

  // Workers AI para resumir noticias (Fase 4)
  // "ai": { "binding": "AI" },

  // Cron: 6:30 y 12:30 hora Guatemala = 12:30 y 18:30 UTC
  "triggers": {
    "crons": ["30 12 * * *", "30 18 * * *"]
  }
}
