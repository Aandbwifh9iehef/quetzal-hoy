{
  "name": "quetzal-hoy",
  "main": "src/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],

  // Assets estáticos servidos desde /public
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },

  // KV para datos dinámicos (tipo de cambio, noticias).
  // Raúl: crear el namespace en Cloudflare (Storage & Databases → KV) y pegar su ID aquí.
  "kv_namespaces": [{ "binding": "DATA", "id": "4020b989ebb049b8ad80d46442dfa06d" }],

  // Dominio propio (la zona compoundclub.fyi está en esta cuenta) y también *.workers.dev
  "workers_dev": true,
  "routes": [{ "pattern": "hoy.compoundclub.fyi", "custom_domain": true }],

  // Workers AI: solo para resumir noticias (≈200 neuronas al día; el plan gratis da 10,000)
  "ai": { "binding": "AI" },

  // Cron (UTC): 12:00 = 6:00 Guatemala → noticias; 12:30 y 18:30 = 6:30 y 12:30 → tipo de cambio
  "triggers": {
    "crons": ["0 12 * * *", "30 12 * * *", "30 18 * * *"]
  },

  // Entorno solo para `npm run dev` en la computadora: KV simulado y sin IA (la IA exige
  // iniciar sesión en Cloudflare). El deploy usa la configuración principal de arriba.
  "env": {
    "local": {
      "kv_namespaces": [{ "binding": "DATA", "id": "local" }]
    }
  }
}
